local currentPet = nil

local function showPet(pet)

	if not pet or not pet:IsA("Model") then
		return
	end

	local petPrice = pet:GetAttribute("Price")
	local currency = pet:GetAttribute("Currency") or "Bucks"
	local petRarity = pet:GetAttribute("Rarity") or "Common"

	if not petPrice then
		return
	end

	currentPet = pet

	title.Text = pet.Name
	price.Text = tostring(petPrice) .. " " .. currency
	rarity.Text = petRarity

	local rarityColor =
		RARITY_COLORS[petRarity]
		or RARITY_COLORS.Common

	rarity.BackgroundColor3 = rarityColor

	createPreview(pet)

	frame.Visible = true
	shadow.Visible = true

	frame.Position = UDim2.new(0.5, -190, 1.1, 0)
	shadow.Position = UDim2.new(0.5, -195, 1.1, 0)

	TweenService:Create(
		frame,
		TweenInfo.new(
			0.45,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(0.5, -190, 0.65, 0)
		}
	):Play()

	TweenService:Create(
		shadow,
		TweenInfo.new(
			0.45,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(0.5, -195, 0.65, 5)
		}
	):Play()
end

--------------------------------------------------
-- ЗАКРЫТИЕ
--------------------------------------------------

local function hidePet()

	currentPet = nil

	local tween = TweenService:Create(
		frame,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad),
		{
			Position = UDim2.new(0.5, -190, 1.1, 0)
		}
	)

	local shadowTween = TweenService:Create(
		shadow,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad),
		{
			Position = UDim2.new(0.5, -195, 1.1, 0)
		}
	)

	tween:Play()
	shadowTween:Play()

	tween.Completed:Connect(function()
		frame.Visible = false
		shadow.Visible = false
	end)
end

close.MouseButton1Click:Connect(hidePet)

--------------------------------------------------
-- НАЖАТИЕ НА ПИТОМЦА
--------------------------------------------------

mouse.Button1Down:Connect(function()

	local target = mouse.Target

	if not target then
		return
	end

	local pet = target:FindFirstAncestorOfClass("Model")

	if not pet then
		return
	end

	if pet:GetAttribute("Price") then
		showPet(pet)
	end
end)

