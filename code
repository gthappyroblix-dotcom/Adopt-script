--------------------------------------------------

local openPosition = UDim2.new(0.5, -180, 0.67, 0)
local shadowOpenPosition = UDim2.new(0.5, -185, 0.67, 8)

local function showPet(pet)

	local data = Pets[pet.Name]

	if not data then
		return
	end

	nameLabel.Text = pet.Name

	rarityLabel.Text = data.Rarity
	rarityLabel.BackgroundColor3 =
		RarityColors[data.Rarity] or RarityColors.Common

	priceLabel.Text =
		tostring(data.Price) .. " " .. data.Currency

	window.Visible = true
	shadow.Visible = true

	window.Position = UDim2.new(0.5, -180, 1.2, 0)
	shadow.Position = UDim2.new(0.5, -185, 1.2, 8)

	TweenService:Create(
		window,
		TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{Position = openPosition}
	):Play()

	TweenService:Create(
		shadow,
		TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{Position = shadowOpenPosition}
	):Play()
end

--------------------------------------------------
-- ЗАКРЫТИЕ
--------------------------------------------------

local function hidePet()

	local tween = TweenService:Create(
		window,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad),
		{Position = UDim2.new(0.5, -180, 1.2, 0)}
	)

	local shadowTween = TweenService:Create(
		shadow,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad),
		{Position = UDim2.new(0.5, -185, 1.2, 8)}
	)

	tween:Play()
	shadowTween:Play()

	tween.Completed:Once(function()
		window.Visible = false
		shadow.Visible = false
	end)
end

closeButton.MouseButton1Click:Connect(hidePet)

--------------------------------------------------
-- КЛИК ПО ПИТОМЦУ
--------------------------------------------------

mouse.Button1Down:Connect(function()

	local target = mouse.Target

	if not target then
		return
	end

	local model = target:FindFirstAncestorOfClass("Model")

	if not model then
		return
	end

	if Pets[model.Name] then
		showPet(model)
	end
end)

print("Pet Price UI успешно запущен!")
